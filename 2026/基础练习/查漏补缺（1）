     *
     * 输入三个整数，找出并输出其中的最大值。
     *
     * 涉及：if-else、关系运算符
     *
     * 示例：输入 5 12 8 → 输出 12
     */
    // >>> 写在这里 <<<
    int a;
    int b;
    int c;
    printf("输入三个整数，用来找出并输出其中的最大值");
    scanf("%d %d %d",&a,&b,&c);
    if(a > b && a > c)
    {
        printf("%d 最大\n",a);
    }
    else if(b > a && b > c)
    {
        printf("%d 最大\n",b);
    }
    else
    printf("%d最大\n",c);




    /*
     * ─── 第4题：打印直角三角形 ─────────────────────────
     *
     * 输入一个行数 n，打印 n 行的直角三角形。
     * 第 1 行 1 个 *，第 2 行 2 个 *，……
     *
     * 涉及：嵌套 for 循环
     *
     * 示例：输入 3 →
     *   *
     *   **
     *   ***
     */
    // >>> 写在这里 <<<
    int s;
    printf("请输入行数：");
    scanf("%d",&s);
    for(int i = 1; i <= s; i++)
    {
        for(int j = 1;j <= i;j++)
        {
            printf("*");
        }
        printf("\n");
    }





    /*
     * ─── 第5题：猜数字升级版 ─────────────────────────
     *
     * 系统预设一个 1~100 之间的数，用户猜，
     * 每次猜完提示"大了"或"小了"，
     * 猜对了显示"恭喜！你猜了 X 次"。
     *
     * 涉及：while 循环、if-else、计数
     *
     * 提示：int target = 50;  // 也可以取个随机数
     *       每次循环 count++ 记录次数
     */
    // >>> 写在这里 <<<
    int target = 50;
    int f;
    int count = 0;
    printf("请猜：");
    
    while(1)
    {
        scanf("%d",&f);
        count++;
        if(f < target)
        {
            printf("小了");
        }
        else if(f > target)
        {
             printf("大了");
        }
        else{
        printf("对了");
        printf("你猜了 %d 次",count);
         break;
        }
    }
   




    return 0;
}
