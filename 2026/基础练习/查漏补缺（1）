#include <stdio.h>

int main() {

    /*
     * ─── 第1题：求范围内所有偶数的和 ─────────────────────
     *
     * 输入两个整数 m 和 n（m < n），
     * 计算 m~n 之间所有偶数的和并输出。
     *
     * 涉及：scanf、for 循环、if、% 运算符
     *
     * 示例：输入 1 10 → 输出 2+4+6+8+10 = 30
     */
    // >>> 写在这里 <<<
    int m;
    int n;
    int sum = 0;
    printf("请输入两个整数；");
    scanf("%d",&m);
    scanf("%d",&n);
    for(int i = m; i <= n;i++)
    {
        if( i % 2 == 0)
        {
            sum += i;
        }
    }
    printf("范围内偶数的和为 %d \n",sum);



    /*
     * ─── 第2题：数字反转 ─────────────────────────────
     *
     * 输入一个三位整数（如 123），
     * 输出它的反转结果（321）。
