     * 示例：输入 789 → 输出 987
     *       输入 120 → 输出 21（前导0不打印）
     */
    // >>> 写在这里 <<<
    int num;
    int ge;
    int shi ;
    int bai ;
    int result ;
    printf("请输入一个三位整数:");
    scanf("%d",&num);
    ge = num % 10;
    shi = (num/10) %10;
    bai = num / 100;
    result = ge * 100 + shi *10 + bai;
    printf("%d\n",result);





    /*
