    /*
     * 练习5：简单计算器（switch）
     * 输入两个整数和一个运算符（+ - * /），用 switch 计算结果
     * 例如输入：10 + 3   → 输出 10 + 3 = 13
     * 注意：除法的商保留2位小数
     * 提示：
     *   char op;
     *   scanf("%d %c %d", &a, &op, &b);
     *   switch(op) { case '+': ... break; ... }
     */
    // >>> 写在这里 <<<
    int a;
    int b;
    double c;
    char op;
    printf("输入两个整数和一个运算符（+ - * /）:");
    scanf("%d %c %d",&a,&op,&b);
    switch(op)
    {
        case '+':  c = a + b; printf("计算结果为：%.2f\n",c);
        break;
        case'-' :  c = a - b; printf("计算结果为：%.2f\n",c);
        break;
        case'*' :  c = a * b; printf("计算结果为：%.2f\n",c);
        break;
        case '/': c = (double)a / b; printf("计算结果为：%.2f\n",c);
        break;
        default : printf("无效运算符\n");
        break;
    }
    



    // ============================================================
