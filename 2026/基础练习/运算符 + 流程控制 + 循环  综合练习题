     *   猜小了 → 打印 "小了"
     *   猜对了 → 打印 "对了！" 并退出循环
     * 提示：while (1) { ... if (...) break; }
     */
    // >>> 写在这里 <<<
    int number = 50;
    int found;
    
    while(1)
    {
    printf("猜数字：\n");
    scanf("%d",&found);
        if(found < 50)
        {
            printf("小了\n");
        }
        
        else if(found > 50)
        {
            printf("大了\n");
        }

        else
        {
            printf("对了");
            break;
        }

    }




    /*
     * 练习8：打印九九乘法表（嵌套 for 循环）
     * 输出格式：
     *   1x1=1
     *   1x2=2  2x2=4
     *   1x3=3  2x3=6  3x3=9
     *   ...（直到 9x9=81）
     */
    // >>> 写在这里 <<<

    for(int i = 1; i <= 9; i++)
    {
        for(int j = 1; j <= i;j++)
        {
            printf("%dx%d=%-2d",j,i,j *i);
        }
        printf("\n");
    }





    return 0;
}
