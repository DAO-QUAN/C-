    // ============================================================

    /*
     * 练习6：1 加到 100（for 循环）
     * 用 for 循环计算 1 + 2 + 3 + ... + 100 的结果
     */
    // >>> 写在这里 <<<
    int count = 0;
    for(int i =1 ;i <= 100;i++){
        count += i;
    }
    
    printf("1 + 2 + 3 + ... + 100 =%d \n",count);





    /*
     * 练习7：猜数字（while 循环）
     * 程序预设一个数字（比如 42），用户不断输入猜测
