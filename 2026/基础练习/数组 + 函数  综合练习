/*
 * 练习2用的函数：遍历打印数组
 * 参数：arr[] 数组, size 数组元素个数
 * 打印格式：每个数后面跟一个空格，最后换行
 */
void print_array(int arr[], int size) {
    // >>> 实现代码 <<<
    for(int i = 0 ; i < size ; i++)
    {
        printf("%d ",arr[i]);
        
    }
    printf("\n");
}

/*
 * 练习3用的函数：求数组平均值
 * 参数：arr[] 数组, size 数组元素个数
 * 返回值：所有元素的平均值（double 类型）
 */
double average(int arr[], int size) {
    // >>> 实现代码 <<<
    int sum = 0;
    for(int i = 0; i < size ; i++)
    {
        sum += arr[i];
    }
    return(double)sum / size;
}

/*
 * 练习4用的函数：找出数组最大值
 * 参数：arr[] 数组, size 数组元素个数
 * 返回值：数组中的最大值
 */
int find_max(int arr[], int size) {
    // >>> 实现代码 <<<
    int max = arr[0];
    for(int i = 1; i < size ; i ++)
    {
        if(arr[i] > max)
        {
            max = arr[i];
        }
    }
    return max;
}

/*
 * 练习5用的函数：原地反转数组
 * 参数：arr[] 数组, size 数组元素个数
 * 不返回，直接修改原数组
 */
void reverse(int arr[], int size) {
    // >>> 实现代码 <<<
    for(int i = 0; i< size/2; i++)
    {
        int temp = arr[i];
        arr[i] = arr[size - 1 - i];
        arr[size - 1 - i] = temp;
    }
}

