/*
 * ============================================================
 *  C 语言 — 指针入门  专项练习
 * ============================================================
 *
 * 先看概念再做题！
 *
 * ─── 指针到底是什么？ ───
 *
 * 内存 = 一排带编号的箱子
 * 变量 = 箱子里放的值
 * 指针 = 箱子的编号（地址）
 *
 *   int  a = 10;    → 一个箱子里放了 10
 *   int *p = &a;    → p 记录着 a 的箱子编号（地址）
 *   *p              → 顺着编号找到箱子，取出里面的值（= 10）
 *
 * ─── 两个最重要的符号 ───
 *
 *   &  → 取地址（拿到箱子的编号）
 *   *  → 解引用（顺着编号找箱子）
 *
 *   int  a = 10;
 *   int *p = &a;      // p 存了 a 的地址
 *   printf("%d", *p); // 输出 10（*p = 顺着 p 找箱子 = a 的值）
 *   *p = 20;          // 改 *p 相当于改 a！
 *   printf("%d", a);  // 输出 20
 *
 * ─── 指针的声明 ───
 *
 *   int  *p;   // p 是一个指针，指向 int 类型
 *   char *q;   // q 是一个指针，指向 char 类型
 *   double *r; // r 是一个指针，指向 double 类型
 */

#include <stdio.h>

int main() {

    // ============================================================
    //  练习1：理解 & 和 *
    // ============================================================
    // ① 声明 int a = 10;
    // ② 声明 int *p = &a;
    // ③ 打印 a 的值、a 的地址、p 的值、*p 的值
    //    观察结果，理解 p 和 &a 是一样的，*p 和 a 是一样的
    //
    // >>> 写在这里 <<<
    int a = 10;
    int *p = &a;
    printf("a的值%d\n",a);
    printf("a的地址%p\n",(void*)p);
    printf("p的值%d\n",*p);
    printf("*p的值%d\n",p);






    // ============================================================
    //  练习2：通过指针修改变量
    // ============================================================
    // ① 声明 int x = 100;
    // ② 声明 int *ptr = &x;
    // ③ 打印 x 的值
    // ④ 通过 *ptr = 200 修改 x 的值
    // ⑤ 再次打印 x 的值（观察是否变成 200）
    //
    // >>> 写在这里 <<<
    int x = 100;
    int *ptr = &x;
    printf("%d",x);
    *ptr = 200;
    printf("%d",x);




    // ============================================================
    //  练习3：指针交换变量（不用第三方变量）
    // ============================================================
    // 之前交换两个变量用 temp，这次用指针实现：
    //
    // 写一个函数 void swap(int *a, int *b)
    //   通过指针交换两个 int 的值
    //
    // 在 main 中：
    //   int x = 10, y = 20;
    //   swap(&x, &y);
    //   打印 x, y → 应该是 20, 10
    //
    // 提示：*a 和 *b 互相交换，用 temp
    //
    // >>> 写在这里 <<<
    int m = 10;
    int n = 20;
    swap(&m, &n );





    // ============================================================
    //  练习4：指针与数组
    // ============================================================
    // 数组名就是数组首元素的地址！
    //   int arr[] = {10, 20, 30};
    //   arr     == &arr[0]    // 数组名 = 第一个元素的地址
    //   *arr    == arr[0]     // *arr = 10
    //   *(arr+1) == arr[1]    // *(arr+1) = 20
    //
    // 用指针遍历数组：
    //   int *p = arr;
    //   for (int i = 0; i < 3; i++) {
    //       printf("%d ", *(p + i));
    //   }
    //
    // 任务：声明 int nums[] = {5, 10, 15, 20, 25};
    //       用指针 p 遍历并打印所有元素
    //
    // >>> 写在这里 <<<
    int nums[] = {5, 10, 15, 20, 25};
    int *p = nums;
    for(int i = 0; i < 5; i++)
    {
        printf("%d", *(p + i));
    }





    // ============================================================
    //  练习5：用指针函数修改数组
    // ============================================================
    // 写一个函数 void double_values(int *arr, int size)
    //   用指针遍历数组，把每个元素的值翻倍
    //
    // 在 main 中：
    //   int data[] = {1, 2, 3, 4, 5};
    //   double_values(data, 5);
    //   打印数组 → 应该是 2, 4, 6, 8, 10
    //
    // 提示：*(arr + i) *= 2
    //
    // >>> 写在这里 <<<
    int data[] = {1, 2, 3, 4, 5};
    double_values(data, 5);





    return 0;
}


// ============================================================
//  函数实现区
// ============================================================

// 练习3：交换函数
void swap(int *a, int *b) {
    // >>> 实现代码 <<<
int temp = 0;
temp = *a;
*a = *b;
*b = temp;

}

// 练习5：翻倍函数
